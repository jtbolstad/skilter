{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Skilter",
  "version": "0.1.0",
  "identifier": "no.skilter.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5330",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Skilter",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
